NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://memory_user:memory_pass@localhost:5432/memory_db
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=memory

MCP_BASE_URL=https://memory.example.com

API_KEY_SECRET=your-super-secret-api-key-secret-min-32-chars-long
JWT_SECRET=your-super-secret-jwt-secret-min-32-chars-long

MEMORY_DEFAULT_LIMIT=20
MEMORY_CONTEXT_MAX_TOKENS=5000

CACHE_TTL=300

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

LOG_LEVEL=info
