# Dashboard API Configuration
# Copy this file to .env and update values as needed

# Base URL for API requests (no trailing slash)
# In production with nginx proxy, use /api/v1
# For local dev with proxy, use /api/v1
VITE_API_BASE_URL=/api/v1

# Router basename — use /dashboard when served behind the backend at /dashboard
# Use / (or leave empty) for standalone/nginx deployment
VITE_BASENAME=/
