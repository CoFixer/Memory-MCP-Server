# Dashboard Runtime Configuration
# This is used by the container entrypoint to inject the backend URL at runtime
# Set this in your deployment platform (Dokploy, Docker, etc.) environment variables
# 
# IMPORTANT: Vite bakes env vars at BUILD time, so this won't work
# if set after the Docker image is built. The entrypoint.sh script
# reads this at container startup and injects it into the HTML.

VITE_API_BASE_URL=https://memory.cofixer.site